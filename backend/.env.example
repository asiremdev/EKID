# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── Database (Neon PostgreSQL) ──────────────────────────────────────────────


# keep Neon credentials secure: do not expose them to client-side code

DATABASE_URL='postgresql://neondb_owner:npg_9srdnzTXRGf5@ep-autumn-credit-at37e0jm-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
# Direct (non-pooled) connection used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/kiddy?sslmode=require"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-please-use-32+chars
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-32+chars
JWT_REFRESH_TTL=30d

# ─── Cookies ─────────────────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ─── Auth tokens (verification / password reset) ─────────────────────────────
EMAIL_VERIFICATION_TTL=86400
PASSWORD_RESET_TTL=3600

# ─── Rate limiting ───────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=10

# ─── Subscriptions ───────────────────────────────────────────────────────────
TRIAL_DAYS=3

# ─── Mail (architecture only — wire a provider later) ────────────────────────
MAIL_FROM="Kiddy <no-reply@kiddy.app>"
MAIL_PROVIDER=console
